{
  "name": "plugin-hyperfy",
  "description": "Coo: an elizaOS agent that lives in a Hyperfy world",
  "version": "1.0.0-beta.40",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@elizaos/cli": "^1.7.2",
    "@elizaos/core": "^1.7.2",
    "@elizaos/plugin-bootstrap": "^1.7.2",
    "@elizaos/plugin-sql": "^1.7.2",
    "@livekit/rtc-node": "^0.13.13",
    "@pixiv/three-vrm": "^3.4.0",
    "dotenv": "17.4.2",
    "hls.js": "^1.6.2",
    "jsonrepair": "3.13.1",
    "livekit-client": "^2.11.4",
    "livekit-server-sdk": "^2.12.0",
    "lodash-es": "^4.17.21",
    "moment": "^2.31.0",
    "msgpackr": "^1.11.2",
    "postprocessing": "^6.37.3",
    "puppeteer": "^24.9.0",
    "ses": "^1.12.0",
    "three": "^0.176.0",
    "three-mesh-bvh": "^0.9.0",
    "viem": "2.57.11",
    "yoga-layout": "^3.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "page-three": "npm:three@0.132.2",
    "page-three-vrm": "npm:@pixiv/three-vrm@3.3.3",
    "prettier": "3.5.3",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "tip-wallet": "node scripts/tip-wallet.mjs",
    "start": "elizaos start",
    "dev": "elizaos dev",
    "build": "tsup && node scripts/build-assets.mjs && cp src/plugin-hyperfy/physx/physx-js-webidl.js src/plugin-hyperfy/physx/physx-js-webidl.wasm dist/ && cp -r src/plugin-hyperfy/public/assets dist/ && cp -r src/plugin-hyperfy/public/avatars dist/ && cp -r src/plugin-hyperfy/public/emotes dist/",
    "lint": "prettier --write ./src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json; base=$?; tsc --noEmit -p tsconfig.strict.json && exit $base",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src"
  },
  "overrides": {
    "simple-git": "4.0.2",
    "@elizaos/plugin-openai": "file:./stubs/unused-elizaos-plugin",
    "@elizaos/plugin-ollama": "file:./stubs/unused-elizaos-plugin",
    "basic-ftp": "6.2.3",
    "pdfjs-dist": "6.4.299",
    "zod": "^4.6.6"
  }
}
