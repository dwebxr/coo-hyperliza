{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    // The base config sets this to false explicitly, which strict alone would not override
    "noImplicitAny": true
  },
  // Every file listed here, and every file it imports, must be strict-clean. src/index.ts is
  // left out: it imports the whole Hyperfy plugin. Add each new module that can be strict.
  "include": [
    // Not its test: @elizaos/plugin-sql's types cannot be resolved through its package exports
    "src/agent-secrets.ts",
    "src/anthropic-models.ts",
    "src/anthropic-models.test.ts",
    "src/anthropic-models.sdk.test.ts",
    "src/anthropic-models.turns.test.ts",
    "src/elevenlabs-speech.ts",
    "src/elevenlabs-speech.test.ts",
    "src/elevenlabs-speech.budget.test.ts",
    "src/llm-provider.ts",
    "src/llm-provider.test.ts",
    "src/usage-budget.ts",
    "src/usage-budget.test.ts",
    "src/openpay-store/**/*.ts",
    // 'three' and 'lodash-es' have no type declarations
    "src/untyped-modules.d.ts",
    "src/plugin-hyperfy/lib/**/*.ts",
    "src/plugin-hyperfy/session/**/*.ts",
    "src/plugin-hyperfy/managers/puppeteer-manager.ts",
    "src/plugin-hyperfy/test-support/net.ts",
    "src/plugin-hyperfy/test-support/net-child.ts",
    "src/plugin-hyperfy/test-support/no-network.ts",
    "src/plugin-hyperfy/test-support/no-network.test.ts",
    "src/plugin-hyperfy/utils.ts"
  ]
}
