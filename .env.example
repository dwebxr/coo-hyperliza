# Claude (required): replies, decisions, JSON extraction and describing what the agent sees
ANTHROPIC_API_KEY=
# Optional. Claude is the only text provider, so if set it must be "anthropic"
LLM_PROVIDER=
ANTHROPIC_SMALL_MODEL=claude-haiku-5-5
ANTHROPIC_LARGE_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max (higher = slower and more expensive)
ANTHROPIC_EFFORT=low

# ElevenLabs voice: text-to-speech, and speech-to-text for voice input
# (voice input needs the key's speech_to_text permission)
ELEVENLABS_XI_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_STABILITY=0.5
ELEVENLABS_VOICE_SIMILARITY_BOOST=0.9
ELEVENLABS_VOICE_STYLE=0.66
ELEVENLABS_VOICE_USE_SPEAKER_BOOST=false
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Speech-to-text model (default scribe_v2) and language (e.g. ja; empty = auto-detect)
ELEVENLABS_STT_MODEL_ID=
ELEVENLABS_STT_LANGUAGE_CODE=

# OpenAI text-to-speech, used only as a fallback when ElevenLabs is unavailable (optional)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# PostgreSQL (required): the embedded PGLite database does not start alongside the Hyperfy engine
POSTGRES_URL=

# elizaOS web UI / API server. Whoever may use it can read and rewrite this file through
# GET/POST /api/system/env/local (every key in it, TIP_WALLET_PRIVATE_KEY included), read the stored agent record
# (GET /api/agents/<id>), control the agent and, over Socket.IO, message it and stream its logs.
# When the CLI loads this project (elizaos start / dev, i.e. bun run start / dev), Coo listens on 127.0.0.1 only
# while SERVER_HOST is unset, and while ELIZA_SERVER_AUTH_TOKEN is unset it locks the REST API (/api answers 401)
# and Socket.IO for the run with a random token it never shows (Socket.IO still accepts a SERVER_API_KEY you set
# yourself; the REST API stays locked). "elizaos start --character <file>" and
# "elizaos dev --character <file>" skip the project and with it those defaults: there only this file protects
# the server, and it needs all three of SERVER_HOST=127.0.0.1, ELIZA_SERVER_AUTH_TOKEN and SERVER_API_KEY (the
# same value). Without them that start serves the API and Socket.IO with no authentication on every interface.
# Keep SERVER_HOST=127.0.0.1 unless remote access is needed.
SERVER_PORT=
SERVER_HOST=127.0.0.1
# Fill this in (a long random string) to use the web UI / API; clients send it as X-API-KEY. When the project is
# loaded it also unlocks Socket.IO unless SERVER_API_KEY is set. The API is then as strong as this token.
ELIZA_SERVER_AUTH_TOKEN=
# The same value as ELIZA_SERVER_AUTH_TOKEN. Socket.IO checks this one; with --character starts nothing copies it.
SERVER_API_KEY=
# Error reports. The elizaOS server sends them (they can hold chat text, file paths and settings) to elizaOS's own
# Sentry project unless SENTRY_DSN names another; empty means that default. When the CLI loads this project, Coo
# turns reporting off while SENTRY_DSN is empty. With "elizaos start --character <file>" only this file holds:
# "off" (any value that is not a DSN) turns it off there too. Put your own DSN here to report to your project.
SENTRY_DSN=off
# elizaOS encrypts the secrets it stores in the agent's database record with this value; its default, "secretsalt",
# is public. Coo copies nothing from this file into that record and deletes what earlier versions stored there,
# also for keys since removed from this file (a failure to do so is logged as an error); elizaOS itself still
# stores POSTGRES_URL there.
SECRET_SALT=

# Hyperfy world WebSocket URL. Coo speaks coo-world's network protocol
# (src/plugin-hyperfy/lib/world-protocol.ts); worlds on other Hyperfy versions may not accept it.
# For a local world (e.g. on port 3000), use: ws://localhost:3000/ws
# The origin of this URL is "the world" for downloads and uploads: assets and the upload API the world
# announces must be on this host and port (or, for assets only, on a public https host). On loopback, the
# spellings localhost, 127.x.x.x and [::1] of the same port count as the same host; any other name for the
# machine does not (write the host the way the world itself does).
# The agent's saved session token is sent only over wss:// (or https://), or to localhost, a loopback or a
# private address; to any other ws:// world the agent connects without it, as a new guest.
WS_URL=wss://play.dwebxr.xyz/ws

# Extra names the agent answers to, comma-separated (e.g. クー)
# Messages containing the agent's name or an alias skip the "should I respond?" LLM check
HYPERFY_AGENT_ALIASES=

# Scene edits by request (move/delete/import objects): off | builders. Default off. "builders" lets a player who
# asks in chat or voice have the world edited when the world itself lets them build: present, with builder rank
# or higher as the world's server reports it, or listed in HYPERFY_OPERATOR_IDS. Anything else = off (logged).
# Turn it on ONLY for a world whose server sets each chat message's sender itself: coo-world does; stock Hyperfy
# does not (it passes on whatever sender id a client writes), so there any visitor could pose as a builder.
# On coo-world without ADMIN_CODE everyone is an admin, so everyone can ask.
HYPERFY_SCENE_EDITS=off
# Player ids or userIds (comma-separated) treated as builders for scene edits while they are in the world
HYPERFY_OPERATOR_IDS=

# App scripts the world sends (code written by whoever builds in the world): off | sandboxed. Default off:
# they are not run, so interactive items (HYPERFY_USE_ITEM), script-driven sky/environment and
# script-animated objects do nothing in the agent; models still load. `sandboxed` locks the whole process
# down (SES) and runs each script behind a membrane; its fetch() reaches public https hosts only. A script
# can still hang or crash the agent, so use it only for worlds whose builders you mostly trust (README
# "World App Scripts"). There is no unsandboxed mode; any other value is reported as an error and means off.
HYPERFY_WORLD_SCRIPTS=off

# true = write every snapshot the agent takes of the world to its working directory (scene_*.jpeg), for
# debugging what it sees. Anything else, or unset = nothing is written.
HYPERFY_DEBUG_SNAPSHOTS=

# Autonomous behavior, only while other players are in the world (see README "Cost Controls")
# Seconds between autonomous steps; most are scripted (patrol/wander, waves, looking around) and cost nothing
AUTONOMY_TICK_MIN_SEC=15
AUTONOMY_TICK_MAX_SEC=30
# Steps where Claude decides what to do: at least this many seconds apart (also after a conversation), at most this many per hour (0 = scripted only)
AUTONOMY_AI_MIN_INTERVAL_SEC=120
AUTONOMY_AI_MAX_PER_HOUR=20
# Patrol route as "x,z; x,z; ..."; empty = wander within 6 m of the spawn point
PATROL_POINTS=

# Usage limits: empty = no limit, 0 = off. Rolling last hour / last 24 hours; reset when the agent restarts.
# Anything that is not a plain number of 0 or more (abc, -1, 1e3, "100 calls") stops the agent at startup:
# an unreadable limit is never taken to mean "no limit". The same goes for the AUTONOMY_AI_* values above,
# AI_MAX_TOKENS_<PURPOSE> and USAGE_REPORT_INTERVAL_MIN.
# When the Claude limit is reached, patrol and waves continue and named products still get their purchase link.
AI_MAX_CALLS_PER_HOUR=
AI_MAX_TOKENS_PER_DAY=
VISION_MAX_PER_HOUR=
VOICE_TTS_MAX_CHARS_PER_DAY=
VOICE_STT_MAX_SECONDS_PER_DAY=
# Output cap of one kind of Claude call, e.g. AI_MAX_TOKENS_CHAT=3000 (purposes: chat, autonomous, should-respond,
# navigation, use-item, vision, reply, ambient, build)
# Usage report in the log every N minutes (0 = off)
USAGE_REPORT_INTERVAL_MIN=60

# Tips (投げゼニ) in coo-world (optional): Coo's own wallet key. Create it with `npm run tip-wallet`,
# which writes it here without printing it. Back it up; move received tips to your main wallet.
# Empty = tips off. The key only signs the world's sign-in message; Coo never sends transactions.
# Read once at startup and then removed from the process environment (it stays in this file).
TIP_WALLET_PRIVATE_KEY=

# OpenPay Store shop clerk (optional)
# Seller handles whose products Coo recommends and shares purchase links for (comma-separated; up to 100 products each),
# or * for products from every seller (up to 100 in total).
# Leave empty to turn the shop off. Buyers pay from their own wallet; Coo never holds money or keys.
OPENPAY_STORE_HANDLES=coo,cipherweb
# Language of the purchase pages: ja | en
OPENPAY_STORE_LOCALE=ja
