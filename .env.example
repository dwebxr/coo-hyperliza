# Claude (required): replies, decisions, JSON extraction and describing what the agent sees
ANTHROPIC_API_KEY=
# Optional. Claude is the only text provider, so if set it must be "anthropic"
LLM_PROVIDER=
ANTHROPIC_SMALL_MODEL=claude-haiku-5-5
ANTHROPIC_LARGE_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max (higher = slower and more expensive)
ANTHROPIC_EFFORT=low

# ElevenLabs voice: text-to-speech, and speech-to-text for voice input
# (voice input needs the key's speech_to_text permission)
ELEVENLABS_XI_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_STABILITY=0.5
ELEVENLABS_VOICE_SIMILARITY_BOOST=0.9
ELEVENLABS_VOICE_STYLE=0.66
ELEVENLABS_VOICE_USE_SPEAKER_BOOST=false
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Speech-to-text model (default scribe_v2) and language (e.g. ja; empty = auto-detect)
ELEVENLABS_STT_MODEL_ID=
ELEVENLABS_STT_LANGUAGE_CODE=

# OpenAI text-to-speech, used only as a fallback when ElevenLabs is unavailable (optional)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# PostgreSQL (required): the embedded PGLite database does not start alongside the Hyperfy engine
POSTGRES_URL=

# elizaOS web UI / API server. Keep 127.0.0.1 (this machine only) unless remote access is needed:
# the API has no authentication unless ELIZA_SERVER_AUTH_TOKEN is set (clients send it as X-API-KEY),
# so set that and restrict network access before using 0.0.0.0.
SERVER_PORT=
SERVER_HOST=127.0.0.1

# Hyperfy world WebSocket URL. Coo speaks coo-world's network protocol
# (src/plugin-hyperfy/lib/world-protocol.ts); worlds on other Hyperfy versions may not accept it.
# For a local world (e.g. on port 3000), use: ws://localhost:3000/ws
WS_URL=wss://play.dwebxr.xyz/ws

# Extra names the agent answers to, comma-separated (e.g. クー)
# Messages containing the agent's name or an alias skip the "should I respond?" LLM check
HYPERFY_AGENT_ALIASES=

# OpenPay Store shop clerk (optional)
# Seller handles whose products Coo recommends and shares purchase links for (comma-separated; up to 100 products each),
# or * for products from every seller (up to 100 in total).
# Leave empty to turn the shop off. Buyers pay from their own wallet; Coo never holds money or keys.
OPENPAY_STORE_HANDLES=masia02,cipherweb
# Language of the purchase pages: ja | en
OPENPAY_STORE_LOCALE=ja
