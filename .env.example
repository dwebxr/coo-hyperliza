# OpenAI Configuration (required if using the Openai LLM Plugin)
OPENAI_API_KEY=

# Anthropic Configuration (required if using the Anthropic LLM Plugin)
ANTHROPIC_API_KEY=

# Which provider generates text: anthropic | openai | ollama | groq.
# Leave empty to use Claude when ANTHROPIC_API_KEY is set. Claude also describes images;
# OpenAI is optional (embeddings, fallback TTS) and ElevenLabs covers speech.
LLM_PROVIDER=
ANTHROPIC_SMALL_MODEL=claude-haiku-5-5
ANTHROPIC_LARGE_MODEL=claude-haiku-5-5
# low | medium | high (higher = slower and more expensive)
ANTHROPIC_EFFORT=low

# Groq Configuration (required if using the Groq LLM Plugin)
GROQ_API_KEY=

# Ollama Configuration (required if using the Ollama LLM Plugin)
OLLAMA_API_ENDPOINT=
OLLAMA_SMALL_MODEL=
OLLAMA_LARGE_MODEL=

# OpenAI TTS (Text-to-Speech) settings
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
OPENAI_TTS_INSTRUCTIONS=

# ElevenLabs Voice Settings (required if using the ElevenLabs Plugin)
ELEVENLABS_XI_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_STABILITY=0.5
ELEVENLABS_VOICE_SIMILARITY_BOOST=0.9
ELEVENLABS_VOICE_STYLE=0.66
ELEVENLABS_VOICE_USE_SPEAKER_BOOST=false
ELEVENLABS_OPTIMIZE_STREAMING_LATENCY=4
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Database Connection
POSTGRES_URL=

# Client App Port
SERVER_PORT=

# Hyperfy World WebSocket URL
# Default: wss://chill.hyperfy.xyz/ws
# For local Hyperfy server (e.g., running on port 3000), use: ws://localhost:3000/ws
WS_URL=wss://chill.hyperfy.xyz/ws

# Extra names the agent answers to, comma-separated (e.g. クー)
# Messages containing the agent's name or an alias skip the "should I respond?" LLM check
HYPERFY_AGENT_ALIASES=
